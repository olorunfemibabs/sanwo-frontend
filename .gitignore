# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Kept local, not part of the product: internal briefs, design working files,
# raw and draft media, and the asset-generation tooling. Only the logo SVGs
# under design/ are published.
/BRIEF.md
/CONCEPT.md
/design/*
!/design/logo/
/design/logo/*
!/design/logo/*.svg
/scripts/gen-image.mjs
/scripts/gen-video.mjs
/scripts/assets.mjs
/scripts/normalize-art.mjs
