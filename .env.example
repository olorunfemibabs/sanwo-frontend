# Copy to .env.local (local) or set in your hosting project settings (deploy).

NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban contract IDs
NEXT_PUBLIC_POOL_CONTRACT_ID=CBFWEYF3B4CESQAS4RVKJLEU52EZLWPEJL4KVRTSUFI73DBI4RY3MV34
NEXT_PUBLIC_RECEIVABLES_CONTRACT_ID=CBYOWRE3PCTVA53DWVCRXNCGP5NCG4ZB62ZJ6S5ZYWKJGQIYKNRFVR2O

# Token the pool holds (read it from pool.get_token()) and its display symbol.
# Set the symbol to USDC once the pool holds USDC; the testnet stand-in note disappears.
NEXT_PUBLIC_TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
NEXT_PUBLIC_TOKEN_SYMBOL=XLM

# First ledger to scan for contract events. Set just before each redeploy.
NEXT_PUBLIC_DEPLOY_LEDGER=5241360

# Public source for the Soroban contracts
NEXT_PUBLIC_CONTRACTS_REPO_URL=https://github.com/JoshdfG/sanwo

# Public URL of the site, used for absolute link-preview image URLs.
# Optional on Vercel: without it the production domain is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
